{
  "id": "reloj-kino",
  "name": "Reloj",
  "version": "0.9.136",
  "apiVersion": 23,
  "entry": "plugin.js",
  "description": "Ve el reloj en la esquina superior derecha del reproductor en la TV cada que veas canales en vivo, pelicuals o series sin interrumpir la reproduccion. En el inicio se puede ver al presionar el simbolo de reloj en la pantalla de ajustes (plugins), Se agrega la opcion de poder ver la hora en que terminara tu pelicula o serie en la parte superior derecha activala en ajustes (desactivada por defecto)",
  "author": "ghosti-vc",
  "homepage": "https://kinotvapp.github.io/kino-plugins/",
  "discoverable": true,
  "hosts": [
    "kinotvapp.github.io"
  ],
  "capabilities": [
    "playerSlot",
    "screen"
  ],
  "screen": {
    "label": "Reloj",
    "labelEn": "Clock",
    "icon": "schedule",
    "menuOpens": "screen"
  },
  "slot": {
    "elements": [
      {
        "id": "ends",
        "kind": "text",
        "mode": "overlay"
      },
      {
        "id": "clock",
        "kind": "text",
        "mode": "overlay"
      },
      {
        "id": "clock-fixed",
        "kind": "text",
        "mode": "fixed"
      }
    ]
  },
  "settings": [
    {
      "key": "format",
      "label": "Formato de hora",
      "labelEn": "Time format",
      "type": "select",
      "default": "24",
      "options": [
        {
          "value": "24",
          "label": "24 horas (por defecto)",
          "labelEn": "24-hour (default)"
        },
        {
          "value": "12",
          "label": "12 horas (AM/PM)",
          "labelEn": "12-hour (AM/PM)"
        }
      ]
    },
    {
      "key": "secLive",
      "label": "TV en vivo",
      "labelEn": "Live TV",
      "type": "section"
    },
    {
      "key": "liveMode",
      "label": "Reloj en TV en vivo",
      "labelEn": "Clock on live TV",
      "type": "select",
      "default": "fixed",
      "options": [
        {
          "value": "fixed",
          "label": "Siempre visible (por defecto)",
          "labelEn": "Always visible (default)"
        },
        {
          "value": "hide",
          "label": "Ocultar reloj",
          "labelEn": "Hide clock"
        }
      ]
    },
    {
      "key": "liveLeft",
      "label": "Mover reloj a la izquierda",
      "labelEn": "Move clock left",
      "type": "select",
      "default": "0",
      "hint": "Aproximado: depende del tamaño de tu TV.",
      "hintEn": "Approximate: depends on your TV size.",
      "options": [
        {
          "value": "0",
          "label": "No mover (por defecto)",
          "labelEn": "Don't move (default)"
        },
        {
          "value": "120",
          "label": "15",
          "labelEn": "15"
        },
        {
          "value": "144",
          "label": "18",
          "labelEn": "18"
        },
        {
          "value": "168",
          "label": "21",
          "labelEn": "21"
        }
      ]
    },
    {
      "key": "secVod",
      "label": "Series y películas",
      "labelEn": "Series and movies",
      "type": "section"
    },
    {
      "key": "vodMode",
      "label": "Reloj en series y películas",
      "labelEn": "Clock on series and movies",
      "type": "select",
      "default": "hide",
      "options": [
        {
          "value": "fixed",
          "label": "Siempre visible",
          "labelEn": "Always visible"
        },
        {
          "value": "hide",
          "label": "Ocultar reloj (por defecto)",
          "labelEn": "Hide clock (default)"
        }
      ]
    },
    {
      "key": "endsAt",
      "label": "Termina a las...",
      "labelEn": "Ends at...",
      "type": "select",
      "default": "off",
      "hint": "Hora en que termina lo que ves.",
      "hintEn": "When what you watch ends.",
      "options": [
        {
          "value": "off",
          "label": "Desactivar (por defecto)",
          "labelEn": "Off (default)"
        },
        {
          "value": "fixed",
          "label": "Siempre visible",
          "labelEn": "Always visible"
        },
        {
          "value": "hide",
          "label": "Ocultar",
          "labelEn": "Hide"
        }
      ]
    },
    {
      "key": "secLook",
      "label": "Aspecto",
      "labelEn": "Look",
      "type": "section"
    },
    {
      "key": "size",
      "label": "Tamaño del texto",
      "labelEn": "Text size",
      "type": "select",
      "default": "normal",
      "options": [
        {
          "value": "small",
          "label": "Pequeño",
          "labelEn": "Small"
        },
        {
          "value": "normal",
          "label": "Normal (por defecto)",
          "labelEn": "Normal (default)"
        },
        {
          "value": "large",
          "label": "Grande",
          "labelEn": "Large"
        },
        {
          "value": "xlarge",
          "label": "Muy grande",
          "labelEn": "Extra large"
        }
      ]
    },
    {
      "key": "color",
      "label": "Color de la letra",
      "labelEn": "Letter colour",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Blanco de Kino (por defecto)",
          "labelEn": "Kino white (default)"
        },
        {
          "value": "white",
          "label": "Blanco",
          "labelEn": "White"
        },
        {
          "value": "yellow",
          "label": "Amarillo",
          "labelEn": "Yellow"
        },
        {
          "value": "cyan",
          "label": "Cian",
          "labelEn": "Cyan"
        },
        {
          "value": "green",
          "label": "Verde",
          "labelEn": "Green"
        },
        {
          "value": "orange",
          "label": "Naranja",
          "labelEn": "Orange"
        },
        {
          "value": "pink",
          "label": "Rosa",
          "labelEn": "Pink"
        },
        {
          "value": "black",
          "label": "Negro",
          "labelEn": "Black"
        }
      ]
    }
  ]
}

{
  "id": "reloj-kino",
  "name": "Reloj",
  "version": "0.9.35",
  "apiVersion": 14,
  "entry": "plugin.js",
  "description": "Un reloj con la hora y la fecha. Aparece en tu menú y, al ver tu película o serie favorita, en el área de etiquetas (kinosocial, noticias) sin pausar la reproducción.",
  "hosts": [
    "kinotvapp.github.io",
    "api.open-meteo.com",
    "ipwho.is"
  ],
  "capabilities": [
    "screen",
    "playerPanelTab"
  ],
  "screen": {
    "label": "Reloj",
    "labelEn": "Clock",
    "icon": "schedule",
    "menuOpens": "screen"
  },
  "panel": {
    "contributes": true,
    "kinds": [
      "title",
      "live"
    ],
    "label": "Reloj",
    "labelEn": "Clock",
    "icon": "schedule"
  }
}
{
  "id": "reloj-kino",
  "name": "reloj-kino",
  "version": "0.9.39",
  "apiVersion": 23,
  "entry": "plugin.js",
  "description": "Ve el reloj en la esquina superior derecha del reproductor en la TV",
  "author": "ghosti-vc",
  "homepage": "https://kinotvapp.github.io/kino-plugins/",
  "discoverable": true,
  "hosts": [
    "kinotvapp.github.io"
  ],
  "capabilities": [
    "playerSlot"
  ],
  "slot": {
    "elements": [
      {
        "id": "clock",
        "kind": "text",
        "mode": "overlay"
      },
      {
        "id": "date",
        "kind": "text",
        "mode": "overlay"
      }
    ]
  },
  "settings": [
    {
      "key": "secLook",
      "label": "Aspecto",
      "labelEn": "Look",
      "type": "section"
    },
    {
      "key": "size",
      "label": "Tamaño del texto",
      "labelEn": "Text size",
      "type": "select",
      "default": "normal",
      "options": [
        {
          "value": "small",
          "label": "Pequeño",
          "labelEn": "Small"
        },
        {
          "value": "normal",
          "label": "Normal (por defecto)",
          "labelEn": "Normal (default)"
        },
        {
          "value": "large",
          "label": "Grande",
          "labelEn": "Large"
        },
        {
          "value": "xlarge",
          "label": "Muy grande",
          "labelEn": "Extra large"
        }
      ]
    },
    {
      "key": "color",
      "label": "Color de la letra",
      "labelEn": "Letter colour",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Blanco de Kino (por defecto)",
          "labelEn": "Kino white (default)"
        },
        {
          "value": "white",
          "label": "Blanco",
          "labelEn": "White"
        },
        {
          "value": "yellow",
          "label": "Amarillo",
          "labelEn": "Yellow"
        },
        {
          "value": "cyan",
          "label": "Cian",
          "labelEn": "Cyan"
        },
        {
          "value": "green",
          "label": "Verde",
          "labelEn": "Green"
        },
        {
          "value": "orange",
          "label": "Naranja",
          "labelEn": "Orange"
        },
        {
          "value": "pink",
          "label": "Rosa",
          "labelEn": "Pink"
        },
        {
          "value": "black",
          "label": "Negro",
          "labelEn": "Black"
        }
      ]
    }
  ]
}

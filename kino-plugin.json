{
  "id": "reloj-kino",
  "name": "Reloj",
  "version": "0.9.99",
  "apiVersion": 23,
  "entry": "plugin.js",
  "description": "Ve el reloj en la esquina superior derecha del reproductor en la TV cada que veas canales en vivo, pelicuals o series sin interrumpir la reproduccion. En el inicio se puede ver al presionar el simbolo de reloj e. la pantallade ajustes (plugins)",
  "author": "ghosti-vc",
  "homepage": "https://kinotvapp.github.io/kino-plugins/",
  "discoverable": true,
  "hosts": [
    "kinotvapp.github.io"
  ],
  "capabilities": [
    "playerSlot",
    "screen"
  ],
  "screen": {
    "label": "Reloj",
    "labelEn": "Clock",
    "icon": "schedule",
    "menuOpens": "screen"
  },
  "slot": {
    "elements": [
      {
        "id": "clock",
        "kind": "text",
        "mode": "overlay"
      },
      {
        "id": "clock-fixed",
        "kind": "text",
        "mode": "fixed"
      }
    ]
  },
  "settings": [
    {
      "key": "format",
      "label": "Formato de hora",
      "labelEn": "Time format",
      "type": "select",
      "default": "24",
      "options": [
        { "value": "24", "label": "24 horas (por defecto)", "labelEn": "24-hour (default)" },
        { "value": "12", "label": "12 horas (AM/PM)", "labelEn": "12-hour (AM/PM)" }
      ]
    },
    {
      "key": "secLive",
      "label": "TV en vivo",
      "labelEn": "Live TV",
      "type": "section"
    },
    {
      "key": "liveMode",
      "label": "Reloj en TV en vivo",
      "labelEn": "Clock on live TV",
      "type": "select",
      "default": "fixed",
      "options": [
        { "value": "fixed", "label": "Siempre visible (por defecto)", "labelEn": "Always visible (default)" },
        { "value": "hide", "label": "Ocultar reloj", "labelEn": "Hide clock" }
      ]
    },
    {
      "key": "secVod",
      "label": "Series y películas",
      "labelEn": "Series and movies",
      "type": "section"
    },
    {
      "key": "vodMode",
      "label": "Reloj en series y películas",
      "labelEn": "Clock on series and movies",
      "type": "select",
      "default": "hide",
      "options": [
        { "value": "fixed", "label": "Siempre visible", "labelEn": "Always visible" },
        { "value": "hide", "label": "Ocultar reloj (por defecto)", "labelEn": "Hide clock (default)" }
      ]
    },
    {
      "key": "secLook",
      "label": "Aspecto",
      "labelEn": "Look",
      "type": "section"
    },
    {
      "key": "size",
      "label": "Tamaño del texto",
      "labelEn": "Text size",
      "type": "select",
      "default": "normal",
      "options": [
        { "value": "small", "label": "Pequeño", "labelEn": "Small" },
        { "value": "normal", "label": "Normal (por defecto)", "labelEn": "Normal (default)" },
        { "value": "large", "label": "Grande", "labelEn": "Large" },
        { "value": "xlarge", "label": "Muy grande", "labelEn": "Extra large" }
      ]
    },
    {
      "key": "color",
      "label": "Color de la letra",
      "labelEn": "Letter colour",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Blanco de Kino (por defecto)", "labelEn": "Kino white (default)" },
        { "value": "white", "label": "Blanco", "labelEn": "White" },
        { "value": "yellow", "label": "Amarillo", "labelEn": "Yellow" },
        { "value": "cyan", "label": "Cian", "labelEn": "Cyan" },
        { "value": "green", "label": "Verde", "labelEn": "Green" },
        { "value": "orange", "label": "Naranja", "labelEn": "Orange" },
        { "value": "pink", "label": "Rosa", "labelEn": "Pink" },
        { "value": "black", "label": "Negro", "labelEn": "Black" }
      ]
    }
  ]
}
